# Copy to .env and fill in. Never commit .env.

BITBUCKET_URL=https://bitbucket.example.com
BITBUCKET_USERNAME=hotfix-svc
BITBUCKET_TOKEN=
BITBUCKET_VERIFY_SSL=true

WEBHOOK_SECRET=
ALLOW_INSECURE_WEBHOOK=false

HOTFIX_PREP_MARKETS_CONFIG=config/markets.yaml
HOTFIX_PREP_TEMPLATE=templates/buildScripts.sh.j2
HOTFIX_PREP_IDEM_DIR=.idempotency
HOTFIX_PREP_DRY_RUN=false

# Optional: used when cloning the HotFix branch
GIT_CLONE_TIMEOUT_SECONDS=120
