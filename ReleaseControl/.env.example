# Copy to .env. Never commit real tokens.
# Auth is PAT/API token only. Do not set BITBUCKET_PASSWORD, JENKINS_PASSWORD, or ARTIFACTORY_PASSWORD.

BITBUCKET_URL=https://bitbucket.example.com
BITBUCKET_USERNAME=x-token-auth
BITBUCKET_TOKEN=
BITBUCKET_VERIFY_SSL=true
BITBUCKET_API_PREFIX=/rest/api/1.0

JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=
JENKINS_TOKEN=
JENKINS_VERIFY_SSL=true

ARTIFACTORY_URL=https://artifactory.example.com/artifactory
ARTIFACTORY_USERNAME=
ARTIFACTORY_TOKEN=
ARTIFACTORY_VERIFY_SSL=true

LOG_LEVEL=INFO
WORKDIR=
